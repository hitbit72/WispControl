# Copia este archivo como ".env" y ajusta los valores a tu entorno local.

DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=America/Mexico_City

DB_NAME=wisp_portal
DB_USER=wisp_admin
DB_PASSWORD=cambia-esta-contrasena
DB_HOST=localhost
DB_PORT=5432

# Clave para cifrar campos sensibles (ej. Router.clave). Generar con:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# IMPORTANTE: si esta clave se pierde o cambia, los valores ya cifrados
# en la base de datos no se pueden volver a descifrar.
FIELD_ENCRYPTION_KEY=
